    -- END
    --   AS is_plp_seen_session_conversion,
    --   CASE
    --     WHEN is_pdp_seen_session = TRUE AND total.transaction_count > 0 THEN TRUE
    --     ELSE FALSE
    -- END
    --   AS is_pdp_seen_session_conversion,
    --   CASE
    --     WHEN is_bag_seen_session = TRUE AND total.transaction_count > 0 THEN TRUE
    --     ELSE FALSE
    -- END
    --   AS is_bag_seen_session_conversion,
    --   CASE
    --     WHEN is_minibag_seen_session = TRUE AND total.transaction_count > 0 THEN TRUE
    --     ELSE FALSE
    -- END
    --   AS is_minibag_seen_session_conversion,
    --   CASE
    --     WHEN is_add_to_bag_session = TRUE AND total.transaction_count > 0 THEN TRUE
    --     ELSE FALSE
    -- END
    --   AS is_add_to_bag_session_conversion,
    --   CASE
    --     WHEN is_add_to_mylist_session = TRUE AND total.transaction_count > 0 THEN TRUE
    --     ELSE FALSE
    -- END
    --   AS is_add_to_mylist_session_conversion,
    --   CASE
    --     WHEN is_mylist_seen_session = TRUE AND total.transaction_count > 0 THEN TRUE
    --     ELSE FALSE
    -- END
    --   AS is_mylist_seen_session_conversion,
    --   CASE
    --     WHEN is_checkout_login_seen_session = TRUE AND total.transaction_count > 0 THEN TRUE
    --     ELSE FALSE
    -- END
    --   AS is_checkout_login_seen_converting_session,
    --   CASE
    --     WHEN is_checkout_shipping_or_pickup_seen_session = TRUE AND total.transaction_count > 0 THEN TRUE
    --     ELSE FALSE
    -- END
    --   AS is_checkout_shipping_or_pickup_seen_converting_session,
    --   CASE
    --     WHEN is_checkout_payment_seen_session = TRUE AND total.transaction_count > 0 THEN TRUE
    --     ELSE FALSE
    -- END
    --   AS is_checkout_payment_seen_converting_session,
    --   CASE
    --     WHEN is_checkout_review_seen_session = TRUE AND total.transaction_count > 0 THEN TRUE
