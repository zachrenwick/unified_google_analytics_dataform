    --   AS is_checkout_complete_session_conversion,
    --   CASE
    --     WHEN is_quickview_seen_session = TRUE AND total.transaction_count > 0 THEN TRUE
    --     ELSE FALSE
    -- END
    --   AS is_quickview_seen_session_conversion,
    --   CASE
    --     WHEN is_account_page_seen_session = TRUE AND max_account_page_seen_hit_number < max_checkout_complete_hit_number THEN TRUE
    --     ELSE FALSE
    -- END
    --   AS is_account_page_seen_session_conversion,
    --   CASE
    --     WHEN total.transaction_count > 0 THEN TRUE
    --     ELSE FALSE
    -- END
    --   AS total_order_confirmation_conversion,
    --   --navigation
    --   CASE
    --     WHEN is_navigation_used_session = TRUE AND total.transaction_count > 0 THEN TRUE
    --     ELSE FALSE
    -- END
    --   AS is_navigation_used_session_conversion,
    --   CASE
    --     WHEN is_primary_navigation_used_session = TRUE AND total.transaction_count > 0 THEN TRUE
    --     ELSE FALSE
    -- END
    --   AS is_primary_navigation_used_session_conversion,
    --   CASE
    --     WHEN is_category_navigation_used_session = TRUE AND total.transaction_count > 0 THEN TRUE
    --     ELSE FALSE
    -- END
    --   AS is_category_navigation_used_session_conversion,
    --   CASE
    --     WHEN is_visual_navigation_used_session = TRUE AND total.transaction_count > 0 THEN TRUE
    --     ELSE FALSE
    -- END
    --   AS is_visual_navigation_used_session_conversion,
    --   --search
    --   CASE
    --     WHEN is_search_used_session = TRUE AND total.transaction_count > 0 THEN TRUE
    --     ELSE FALSE
    -- END
    --   AS is_search_used_session_conversion,
    --   CASE
    --     WHEN is_regular_search_result_used_session = TRUE AND total.transaction_count > 0 THEN TRUE
    --     ELSE FALSE
    -- END
    --   AS is_regular_search_result_used_session_conversion,
    --   CASE
    --     WHEN is_plp_redirect_search_used_session = TRUE AND total.transaction_count > 0 THEN TRUE
    --     ELSE FALSE
    -- END
    --   AS is_plp_redirect_search_used_session_conversion,
    --   CASE
    --     WHEN is_pdp_redirect_search_used_session = TRUE AND total.transaction_count > 0 THEN TRUE
    --     ELSE FALSE
    -- END
    --   AS is_pdp_redirect_search_used_session_conversion,
    --   CASE
    --     WHEN is_content_suggestion_search_used_session = TRUE AND total.transaction_count > 0 THEN TRUE
